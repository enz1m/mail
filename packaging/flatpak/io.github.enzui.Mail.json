{
  "app-id": "io.github.enzui.Mail",
  "branch": "stable",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "mail-app",
  "finish-args": [
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--talk-name=org.freedesktop.secrets"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "mail",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --locked --offline --release --jobs \"${FLATPAK_BUILDER_N_JOBS:-2}\" --bin mail-app",
        "install -Dm755 target/release/mail-app /app/bin/mail-app",
        "install -Dm644 assets/io.github.enzui.Mail.desktop /app/share/applications/io.github.enzui.Mail.desktop",
        "install -Dm644 packaging/flatpak/io.github.enzui.Mail.metainfo.xml /app/share/metainfo/io.github.enzui.Mail.metainfo.xml",
        "install -Dm644 assets/io.github.enzui.Mail.svg /app/share/icons/hicolor/scalable/apps/io.github.enzui.Mail.svg",
        "install -Dm644 LICENSE /app/share/licenses/io.github.enzui.Mail/LICENSE"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/enz1m/mail.git",
          "commit": "@ENZIM_SOURCE_COMMIT@",
          "disable-submodules": true
        },
        {
          "type": "archive",
          "url": "https://github.com/enz1m/mail/releases/download/v0.1.1/mail-cargo-vendor-0.1.1.tar.xz",
          "sha256": "fee2dab67e291e2bbcc745f3ae52c2e05b8a2cbbf72d95a21c37292494aeda72",
          "strip-components": 1
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/enz1m/enzim-winit/405e1caca89357f6da20eafe7ed8abc686567092/wayland-protocols/xdg-session-management-v1.xml",
          "sha256": "3674591ca8e68f76297c535e8edd6783d84b59086c38ebe08ff5ff1f2dec5bae",
          "dest": "vendor/winit-0.30.13/wayland-protocols"
        }
      ]
    }
  ]
}
